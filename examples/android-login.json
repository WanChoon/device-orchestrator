[
  {
    "id": "android-smoke",
    "kind": "android",
    "selector": { "tags": ["android"] },
    "timeout_s": 60,
    "max_attempts": 3,
    "steps": [
      { "op": "tap", "id": "com.example.app:id/sign_in" },
      {
        "op": "type_secret",
        "id": "com.example.app:id/username",
        "credential": "demo-app",
        "field": "username"
      },
      {
        "op": "type_secret",
        "id": "com.example.app:id/password",
        "credential": "demo-app",
        "field": "password"
      },
      { "op": "tap", "accessibility_id": "Continue" },
      { "op": "wait", "seconds": 1 },
      { "op": "read", "id": "com.example.app:id/status", "into": "status" }
    ]
  },
  {
    "id": "web-smoke",
    "kind": "web",
    "selector": { "tags": ["web"] },
    "timeout_s": 60,
    "steps": [
      { "op": "goto", "url": "https://example.com/" },
      { "op": "read", "selector": "h1", "into": "heading" }
    ]
  }
]
