  "meta": {
    "title": "device-orchestrator",
    "output": "orchestrator.html",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "dispatch",
        "label": "Dispatch path",
        "focus": [
          "client",
          "api",
          "queue",
          "sched",
          "registry",
          "contract",
          "android",
          "web"
        ],
        "note": "One shared queue. The device is picked when a worker leases it, not at submit time, so a retry lands on different hardware."
      },
      {
        "id": "failure",
        "label": "When a device wedges",
        "focus": [
          "sched",
          "health",
          "registry",
          "sessions",
          "adb"
        ],
        "note": "The probe is a real adb round trip on a short deadline: a wedged device accepts TCP then answers nothing."
      },
      {
        "id": "contract",
        "label": "One contract, two backends",
        "focus": [
          "contract",
          "android",
          "web",
          "phone",
          "browser"
        ],
        "note": "core/ never imports a target. A browser slot is a device with transport=virtual, so leases and selectors need no special case."
      },
      {
        "id": "observability",
        "label": "Progress and logs",
        "focus": [
          "sched",
          "hub",
          "ws",
          "log"
        ],
        "note": "One correlation id per task, inherited through asyncio context. Fan-out is bounded per subscriber, oldest-first."
      }
    ]
  },
